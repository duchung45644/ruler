    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.14.0",
    "happy-dom": "21.0.3",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
